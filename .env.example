PORT=3000

# Límites de subida; predeterminados: 5 solicitudes cada 900000 ms (15 minutos).
UPLOAD_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_WINDOW_MS=900000

# Local: ruta al archivo de cuenta de servicio. Render: puede usarse una Secret File o FIREBASE_SERVICE_ACCOUNT_JSON.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
ADMIN_UID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
