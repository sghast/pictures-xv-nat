PORT=3000

# Límites de subida; el servicio de pruebas usa 15 por navegador y 1000 por IP cada 15 minutos.
UPLOAD_RATE_LIMIT_MAX=15
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_IP_MAX=1000

# Secreto aleatorio de al menos 32 bytes para firmar la cookie de visitante.
UPLOAD_COOKIE_SECRET=

# Local: ruta al archivo de cuenta de servicio. Render: puede usarse una Secret File o FIREBASE_SERVICE_ACCOUNT_JSON.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
ADMIN_UID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
